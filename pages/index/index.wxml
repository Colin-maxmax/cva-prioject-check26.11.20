<view class="home-page">
  <view class="hero">
    <view class="hero-greeting">您好{{username ? '，' + username : ''}}</view>
    <view class="hero-title">3 分钟了解您的脑卒中风险</view>
    <view class="hero-desc">基于 18 项风险因素，生成个性化健康建议</view>
  </view>

  <view class="quick-grid">
    <view class="quick-item" wx:for="{{quickActions}}" wx:key="key" data-key="{{item.key}}" bindtap="onQuickAction">
      <view class="quick-icon {{item.color}}">{{item.icon}}</view>
      <view class="quick-label">{{item.label}}</view>
    </view>
  </view>

  <view class="card last-card" bindtap="goReport">
    <view class="card-head">
      <text class="card-title">上次评估</text>
      <view class="head-actions">
        <text class="more" catchtap="refreshLatest">刷新</text>
        <text class="more">查看报告 ›</text>
      </view>
    </view>
    <block wx:if="{{latest}}">
      <view class="last-main">
        <view class="last-name">{{latest.patientName || '未命名'}}（{{latest.age || '--'}}岁 / {{latest.gender || '--'}}）</view>
        <view class="last-risk" style="color: {{latestRiskColor}}">{{latest.riskLevel}}</view>
      </view>
      <view class="last-meta">{{latest.dateTime}} · 概率 {{latest.probability}}%</view>
    </block>
    <view wx:else class="last-empty">还没有评估记录，点击开始第一次评估。</view>
  </view>

  <view class="notice" bindtap="onNoticeTap">
    <text class="notice-icon {{currentNotice.tone}}">{{currentNotice.icon}}</text>
    <text class="notice-text">{{currentNotice.text}}</text>
    <text class="notice-arrow">›</text>
  </view>

  <view class="card">
    <view class="card-head">
      <text class="card-title">健康知识</text>
      <text class="more" catchtap="goHealth">更多 ›</text>
    </view>
    <view class="coming-row" bindtap="goHealth">
      <view class="coming-dot"></view>
      <view class="coming-info">
        <view class="coming-name">内容即将优化上线</view>
        <view class="coming-desc">正在完善内容，敬请期待</view>
      </view>
    </view>
  </view>

  <view class="faq-link" bindtap="goFaq">常见问题 ›</view>
  <view class="home-disclaimer">结果仅供参考，不构成医疗诊断。如有紧急症状请拨打 120。</view>
</view>
