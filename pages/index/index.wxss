page {
  background: #f5f7fa;
}

.home-page {
  min-height: 100vh;
  padding-bottom: 50rpx;
  box-sizing: border-box;
}

.hero {
  background: linear-gradient(135deg, #2F80ED, #4F9DFF);
  padding: 70rpx 40rpx 90rpx;
  color: #fff;
}

.hero-greeting {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.82);
  margin-bottom: 18rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.35;
}

.hero-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.82);
  line-height: 1.6;
}

.quick-grid {
  margin: -54rpx 32rpx 0;
  background: #fff;
  border-radius: 22rpx;
  padding: 30rpx 12rpx;
  display: flex;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.08);
  position: relative;
  z-index: 2;
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
}

.blue { background: #2F80ED; }
.teal { background: #0E9F6E; }
.orange { background: #F59E0B; }
.red { background: #EF4444; }

.quick-label {
  font-size: 24rpx;
  color: #374151;
}

.card {
  margin: 28rpx 32rpx 0;
  background: #fff;
  border-radius: 22rpx;
  padding: 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(15, 23, 42, 0.04);
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.head-actions {
  display: flex;
  align-items: center;
}

.head-actions .more + .more {
  margin-left: 18rpx;
}

.more {
  font-size: 24rpx;
  color: #2F80ED;
}

.last-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.last-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1f2937;
}

.last-risk {
  font-size: 30rpx;
  font-weight: 700;
}

.last-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

.last-empty {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.6;
  padding: 10rpx 0;
}

.notice {
  margin: 24rpx 32rpx 0;
  background: #fff8e1;
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  display: flex;
  align-items: center;
}

.notice-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #F59E0B;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
  line-height: 36rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.notice-icon.blue { background: #2F80ED; }
.notice-icon.teal { background: #0E9F6E; }
.notice-icon.orange { background: #F59E0B; }
.notice-icon.red { background: #EF4444; }

.notice-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #8a5a00;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.notice-arrow {
  color: #d6a21a;
  font-size: 30rpx;
}

.coming-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
}

.coming-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #F59E0B;
  margin: 12rpx 18rpx 0 0;
  flex-shrink: 0;
}

.coming-name {
  font-size: 28rpx;
  color: #1f2937;
  line-height: 1.5;
}

.coming-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.faq-link {
  text-align: center;
  color: #6b7280;
  font-size: 26rpx;
  margin-top: 30rpx;
}

.home-disclaimer {
  text-align: center;
  color: #9ca3af;
  font-size: 24rpx;
  line-height: 1.6;
  margin: 30rpx 40rpx 0;
}
