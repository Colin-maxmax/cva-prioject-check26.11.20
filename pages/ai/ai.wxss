page {
  background: #f5f7fa;
}

.ai-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

.chat-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 16rpx;
  background: #fff;
  border-bottom: 1rpx solid #f1f5f9;
  flex-shrink: 0;
}

.head-btn {
  width: 72rpx;
  height: 72rpx;
  line-height: 70rpx;
  text-align: center;
  font-size: 34rpx;
  color: #374151;
  border-radius: 50%;
}

.head-btn-hover {
  background: #f3f5f9;
}

.head-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.msg-list {
  flex: 1;
  height: 0;
  padding: 24rpx 28rpx 0;
  box-sizing: border-box;
}

/* 历史会话抽屉 */
.drawer-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(17, 24, 39, 0.35);
  z-index: 20;
  display: flex;
}

.drawer {
  width: 78vw;
  max-width: 560rpx;
  height: 100%;
  background: #fff;
  display: flex;
  flex-direction: column;
  animation: drawerIn 0.2s ease;
}

@keyframes drawerIn {
  from { transform: translateX(-100%); }
  to { transform: translateX(0); }
}

.drawer-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx 18rpx;
  border-bottom: 1rpx solid #f1f5f9;
  flex-shrink: 0;
}

.drawer-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.drawer-new {
  font-size: 24rpx;
  color: #2F80ED;
}

.drawer-list {
  flex: 1;
  height: 0;
  padding: 8rpx 0;
}

.session-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
}

.session-item.active {
  background: #eff6ff;
}

.session-main {
  flex: 1;
  min-width: 0;
}

.session-title {
  font-size: 26rpx;
  color: #1f2937;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.session-time {
  font-size: 20rpx;
  color: #9ca3af;
  margin-top: 4rpx;
}

.session-del {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  color: #cbd5e1;
  font-size: 34rpx;
  flex-shrink: 0;
}

.drawer-empty {
  text-align: center;
  color: #9ca3af;
  font-size: 24rpx;
  padding: 60rpx 0;
}

.tip-card {
  background: #eff6ff;
  color: #2F80ED;
  font-size: 23rpx;
  line-height: 1.6;
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
  margin-bottom: 24rpx;
}

.welcome {
  text-align: center;
  padding: 40rpx 40rpx 20rpx;
}

.welcome-icon {
  width: 92rpx;
  height: 92rpx;
  line-height: 92rpx;
  margin: 0 auto 18rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #2F80ED, #4F9DFF);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}

.welcome-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.welcome-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #9ca3af;
  line-height: 1.7;
}

.msg-row {
  display: flex;
  margin-bottom: 22rpx;
}

.msg-row.from-ai {
  justify-content: flex-start;
}

.msg-row.from-user {
  justify-content: flex-end;
}

.msg-stack {
  max-width: 78%;
  display: flex;
  flex-direction: column;
}

.msg-author {
  font-size: 20rpx;
  color: #9ca3af;
  margin: 0 0 6rpx 6rpx;
}

.from-user .msg-author {
  text-align: right;
  margin: 0 6rpx 6rpx 0;
  color: #b6c2d2;
}

.msg-bubble {
  max-width: 100%;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  display: flex;
  flex-direction: column;
}

.from-ai .msg-bubble {
  background: #fff;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.05);
  border-top-left-radius: 6rpx;
}

.from-user .msg-bubble {
  background: #2F80ED;
  border-top-right-radius: 6rpx;
}

.msg-content {
  font-size: 27rpx;
  line-height: 1.7;
  word-break: break-word;
  white-space: pre-wrap;
}

.from-ai .msg-content {
  color: #1f2937;
}

.from-user .msg-content {
  color: #fff;
}

.msg-time {
  margin-top: 8rpx;
  font-size: 20rpx;
  align-self: flex-end;
}

.from-ai .msg-time {
  color: #9ca3af;
}

.from-user .msg-time {
  color: rgba(255, 255, 255, 0.7);
}

.typing .msg-content {
  color: #9ca3af;
}

.cursor {
  color: #2F80ED;
  margin-left: 2rpx;
  animation: blink 1s steps(1) infinite;
}

@keyframes blink {
  0%, 50% { opacity: 1; }
  51%, 100% { opacity: 0; }
}

.quick-list {
  margin: 10rpx 0 30rpx;
}

.quick-title {
  font-size: 22rpx;
  color: #9ca3af;
  margin-bottom: 12rpx;
}

.quick-chip {
  display: inline-block;
  padding: 10rpx 20rpx;
  margin: 0 12rpx 12rpx 0;
  background: #fff;
  border: 1rpx solid #dbeafe;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #2F80ED;
}

.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(15, 23, 42, 0.04);
}

.input-box {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #f3f5f9;
  border-radius: 36rpx;
  font-size: 27rpx;
  color: #1f2937;
}

.send-btn {
  margin-left: 16rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 34rpx;
  border-radius: 36rpx;
  background: #2F80ED;
  color: #fff;
  font-size: 27rpx;
}

.send-btn[disabled] {
  opacity: 0.6;
  color: #fff;
  background: #2F80ED;
}
