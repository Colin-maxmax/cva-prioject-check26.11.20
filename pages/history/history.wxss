page {
  background: #f5f7fa;
}

.history-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

.page-header {
  background: linear-gradient(135deg, #EAF3FF, #DCEBFF);
  padding: 40rpx 36rpx 44rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.header-info {
  flex: 1;
  min-width: 0;
}

.export-btn {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 12rpx 26rpx;
  background: #fff;
  color: #2F80ED;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(47, 128, 237, 0.15);
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1f2937;
}

.page-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #5b6b82;
}

.state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #9ca3af;
  font-size: 28rpx;
}

.offline-tip {
  margin: 24rpx 32rpx 0;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  background: #fff8e1;
  color: #8a5a00;
  font-size: 23rpx;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  margin: 24rpx 32rpx 0;
}

.filter-chip {
  margin: 0 14rpx 14rpx 0;
  padding: 10rpx 22rpx;
  background: #fff;
  border: 1rpx solid #e5e7eb;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.filter-chip.active {
  background: #2F80ED;
  border-color: #2F80ED;
  color: #fff;
}

.record-card {
  margin: 0 32rpx 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(15, 23, 42, 0.04);
  border-left: 8rpx solid #2F80ED;
}

.record-card.high { border-left-color: #D32F2F; }
.record-card.medium { border-left-color: #ED6C02; }
.record-card.low { border-left-color: #2E7D32; }

.record-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.risk-badge {
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.risk-badge.high {
  background: #fef2f2;
  color: #D32F2F;
}

.risk-badge.medium {
  background: #fff7ed;
  color: #ED6C02;
}

.risk-badge.low {
  background: #f0fdf4;
  color: #2E7D32;
}

.risk-badge.default {
  background: #eff6ff;
  color: #2F80ED;
}

.record-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #9ca3af;
}

.meta-right {
  display: flex;
  align-items: center;
}

.record-delete {
  margin-left: 16rpx;
  padding: 4rpx 8rpx;
  color: #EF4444;
  font-size: 22rpx;
}

.record-bottom {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.record-metrics {
  flex: 1;
  display: flex;
}

.metric {
  margin-right: 20rpx;
  font-size: 23rpx;
  color: #6b7280;
}

.source-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  margin-left: 10rpx;
}

.source-badge.mp {
  background: #ecfdf5;
  color: #0E9F6E;
}

.source-badge.web {
  background: #eff6ff;
  color: #2F80ED;
}

.source-badge.local {
  background: #f3f4f6;
  color: #6b7280;
}

.chevron {
  color: #cbd5e1;
  font-size: 34rpx;
  margin-left: 10rpx;
  line-height: 1;
}

.empty-card {
  margin: 60rpx 32rpx;
  background: #fff;
  border-radius: 22rpx;
  padding: 60rpx 32rpx;
  text-align: center;
  box-shadow: 0 6rpx 24rpx rgba(15, 23, 42, 0.04);
}

.empty-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #eff6ff;
  color: #2F80ED;
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9ca3af;
  line-height: 1.6;
}

.empty-action {
  display: inline-block;
  margin-top: 24rpx;
  color: #2F80ED;
  font-size: 26rpx;
}

.legacy-card {
  margin: 24rpx 32rpx;
  background: #fff8e1;
  border-radius: 18rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
}

.legacy-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #F59E0B;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.legacy-info {
  flex: 1;
  min-width: 0;
}

.legacy-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #8a5a00;
}

.legacy-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9a7a3a;
  line-height: 1.5;
}

.legacy-btn {
  flex: 0 0 112rpx;
  height: 64rpx;
  line-height: 1;
  margin-left: 18rpx;
  padding: 0;
  border-radius: 32rpx;
  background: #F59E0B;
  color: #fff;
  font-size: 24rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.legacy-btn::after {
  border: none;
}

.danger-row {
  margin: 36rpx 32rpx 0;
  padding: 22rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #fff;
  border: 1rpx solid #fecaca;
  color: #D32F2F;
  font-size: 26rpx;
}

.danger-tip {
  text-align: center;
  margin-top: 12rpx;
  font-size: 21rpx;
  color: #9ca3af;
}

.detail-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.detail-sheet {
  width: 100%;
  height: 84vh;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 0 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  animation: sheetUp 0.25s ease;
}

@keyframes sheetUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.detail-head {
  flex-shrink: 0;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 28rpx 0 20rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.detail-head-info {
  flex: 1;
  min-width: 0;
}

.detail-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.detail-meta {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #9ca3af;
}

.detail-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f3f4f6;
  color: #6b7280;
  font-size: 36rpx;
  line-height: 56rpx;
  text-align: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.detail-body {
  flex: 1;
  min-height: 0;
  padding-bottom: 12rpx;
}

.detail-risk-card {
  margin-top: 24rpx;
  border-radius: 18rpx;
  padding: 24rpx;
  background: #eff6ff;
  text-align: center;
}

.detail-risk-card.high { background: #fef2f2; }
.detail-risk-card.medium { background: #fff7ed; }
.detail-risk-card.low { background: #f0fdf4; }

.detail-risk-label {
  font-size: 23rpx;
  color: #6b7280;
}

.detail-risk-level {
  font-size: 56rpx;
  font-weight: 700;
  margin: 8rpx 0 20rpx;
}

.detail-risk-level.high { color: #D32F2F; }
.detail-risk-level.medium { color: #ED6C02; }
.detail-risk-level.low { color: #2E7D32; }
.detail-risk-level.default { color: #2F80ED; }

.detail-metrics {
  display: flex;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  padding-top: 18rpx;
}

.detail-metric {
  flex: 1;
  text-align: center;
}

.detail-metric + .detail-metric {
  border-left: 1rpx solid rgba(0, 0, 0, 0.05);
}

.dm-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}

.dm-label {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #9ca3af;
}

.detail-section {
  margin-top: 24rpx;
}

.detail-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 14rpx;
}

.detail-factors {
  display: flex;
  flex-wrap: wrap;
}

.detail-factor {
  margin: 0 12rpx 12rpx 0;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background: #eff6ff;
  color: #2F80ED;
  font-size: 23rpx;
}

.detail-muted {
  font-size: 24rpx;
  color: #9ca3af;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f8fafc;
  font-size: 24rpx;
}

.dr-label {
  color: #9ca3af;
}

.dr-value {
  color: #4b5563;
  text-align: right;
  margin-left: 20rpx;
}

.detail-disclaimer {
  margin: 20rpx 0 0;
  font-size: 24rpx;
  color: #9ca3af;
  line-height: 1.5;
  text-align: center;
}

.detail-advice {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.75;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 20rpx 22rpx;
}

.detail-tools {
  display: flex;
  margin-top: 20rpx;
}

.detail-tool-btn {
  flex: 1;
  height: 76rpx;
  border-radius: 38rpx;
  background: #fff;
  color: #2F80ED;
  border: 1rpx solid #bfdbfe;
  font-size: 26rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.detail-tool-btn + .detail-tool-btn {
  margin-left: 18rpx;
}

.detail-tool-btn::after {
  border: none;
}

.detail-actions {
  display: flex;
  margin-top: 22rpx;
}

.detail-delete-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 42rpx;
  background: #fff;
  color: #D32F2F;
  border: 1rpx solid #fecaca;
  font-size: 28rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.detail-delete-btn::after {
  border: none;
}

.detail-close-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 42rpx;
  background: #2F80ED;
  color: #fff;
  font-size: 28rpx;
  border: none;
  margin-left: 18rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.detail-close-btn::after {
  border: none;
}
