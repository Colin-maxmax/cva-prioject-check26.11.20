page {
  background: #f5f7fa;
}

.result-page {
  min-height: 100vh;
  padding-bottom: 50rpx;
  box-sizing: border-box;
}

.page-header {
  background: linear-gradient(135deg, #EAF3FF, #DCEBFF);
  padding: 40rpx 36rpx 44rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1f2937;
}

.page-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #5b6b82;
}

.state {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #9ca3af;
  font-size: 28rpx;
}

.result-card {
  margin: 24rpx 32rpx 0;
  background: #fff;
  border-radius: 22rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(15, 23, 42, 0.06);
  border-top: 8rpx solid #2F80ED;
}

.result-card.high { border-top-color: #D32F2F; }
.result-card.medium { border-top-color: #ED6C02; }
.result-card.low { border-top-color: #2E7D32; }

.patient-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 24rpx;
}

.patient-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.patient-meta {
  font-size: 24rpx;
  color: #6b7280;
}

.risk-label {
  text-align: center;
  font-size: 24rpx;
  color: #9ca3af;
}

.risk-level {
  text-align: center;
  font-size: 64rpx;
  font-weight: 700;
  margin: 10rpx 0 26rpx;
}

.risk-level.high { color: #D32F2F; }
.risk-level.medium { color: #ED6C02; }
.risk-level.low { color: #2E7D32; }
.risk-level.default { color: #2F80ED; }

.prob-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.prob-label {
  font-size: 24rpx;
  color: #6b7280;
}

.prob-value {
  font-size: 34rpx;
  font-weight: 700;
}

.prob-value.high { color: #D32F2F; }
.prob-value.medium { color: #ED6C02; }
.prob-value.low { color: #2E7D32; }
.prob-value.default { color: #2F80ED; }

.prob-track {
  height: 14rpx;
  background: #f1f5f9;
  border-radius: 7rpx;
  overflow: hidden;
  margin: 12rpx 0 24rpx;
}

.prob-fill {
  height: 100%;
  border-radius: 7rpx;
}

.prob-fill.high { background: #D32F2F; }
.prob-fill.medium { background: #ED6C02; }
.prob-fill.low { background: #2E7D32; }
.prob-fill.default { background: #2F80ED; }

.prob-fill.w10 { width: 10%; }
.prob-fill.w20 { width: 20%; }
.prob-fill.w30 { width: 30%; }
.prob-fill.w40 { width: 40%; }
.prob-fill.w50 { width: 50%; }
.prob-fill.w60 { width: 60%; }
.prob-fill.w70 { width: 70%; }
.prob-fill.w80 { width: 80%; }
.prob-fill.w90 { width: 90%; }
.prob-fill.w100 { width: 100%; }

.score-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  border-top: 1rpx solid #f3f4f6;
  padding-top: 20rpx;
}

.score-label {
  font-size: 24rpx;
  color: #6b7280;
}

.score-value {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
}

.card {
  margin: 24rpx 32rpx 0;
  background: #fff;
  border-radius: 22rpx;
  padding: 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(15, 23, 42, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 18rpx;
}

.factors {
  display: flex;
  flex-wrap: wrap;
}

.factor {
  margin: 0 14rpx 14rpx 0;
  padding: 8rpx 18rpx;
  background: #eff6ff;
  color: #2F80ED;
  border-radius: 22rpx;
  font-size: 24rpx;
}

.muted {
  font-size: 24rpx;
  color: #9ca3af;
}

.advice-card {
  margin: 24rpx 32rpx 0;
  padding: 24rpx;
  border-radius: 18rpx;
  border-left: 8rpx solid #2F80ED;
  background: #eff6ff;
}

.advice-card.high {
  background: #fef2f2;
  border-left-color: #D32F2F;
}

.advice-card.medium {
  background: #fff7ed;
  border-left-color: #ED6C02;
}

.advice-card.low {
  background: #f0fdf4;
  border-left-color: #2E7D32;
}

.advice-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 10rpx;
}

.advice-text {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.7;
}

.actions-card {
  padding: 28rpx;
}

.btn-primary {
  width: 100%;
  height: 92rpx;
  border-radius: 46rpx;
  background: linear-gradient(135deg, #0E9F6E, #2F80ED);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.btn-primary::after {
  border: none;
}

.action-row {
  display: flex;
  margin-top: 18rpx;
}

.btn-ghost {
  flex: 1;
  height: 84rpx;
  border-radius: 42rpx;
  background: #fff;
  color: #2F80ED;
  border: 1rpx solid #bfdbfe;
  font-size: 28rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.btn-ghost + .btn-ghost {
  margin-left: 18rpx;
}

.btn-ghost::after {
  border: none;
}

.home-link {
  text-align: center;
  color: #9ca3af;
  font-size: 24rpx;
  margin-top: 22rpx;
}

.disclaimer {
  margin: 24rpx 40rpx 0;
  font-size: 24rpx;
  color: #9ca3af;
  line-height: 1.6;
  text-align: center;
}
