@import "../agreement/agreement.wxss";

.version-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 18rpx rgba(15, 23, 42, 0.04);
}

.version-head {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.version-badge {
  font-size: 34rpx;
  font-weight: 700;
  margin-right: 12rpx;
}

.type-badge {
  font-size: 26rpx;
  font-weight: 600;
  margin-right: 12rpx;
}

/* 版本升级：深蓝 */
.version-item.major .version-badge,
.version-item.major .type-badge {
  color: #1E40AF;
}

/* 特征更新：绿色 */
.version-item.minor .version-badge,
.version-item.minor .type-badge {
  color: #0E9F6E;
}

/* 修订补丁：橙色 */
.version-item.patch .version-badge,
.version-item.patch .type-badge {
  color: #EA8C1E;
}

.version-date {
  font-size: 22rpx;
  color: #9ca3af;
  margin-left: auto;
}

.version-line {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.7;
}
