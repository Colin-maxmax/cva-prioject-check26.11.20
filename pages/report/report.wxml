<view class="report-page">
  <view class="page-head">
    <view class="page-title">健康报告</view>
    <view class="page-sub">最近一次评估与风险趋势</view>
  </view>

  <view wx:if="{{loading}}" class="state">加载中...</view>

  <block wx:elif="{{latest}}">
    <view class="card latest-card">
      <view class="latest-top">
        <view>
          <view class="latest-name">{{latest.patientName || '未命名'}}（{{latest.age || '--'}}岁 / {{latest.gender || '--'}}）</view>
          <view class="latest-date">{{latest.dateShort}}</view>
        </view>
        <view class="risk-badge" style="color: {{latestRiskColor}}">{{latest.riskLevel}}</view>
      </view>

      <view class="latest-metrics">
        <view class="metric">
          <view class="metric-value" style="color: {{latestRiskColor}}">{{latest.probability}}%</view>
          <view class="metric-label">患病概率</view>
        </view>
      </view>

      <view class="factors" wx:if="{{latest.riskFactors.length > 0}}">
        <text class="factor" wx:for="{{latest.riskFactors}}" wx:key="*this">{{item}}</text>
      </view>

      <view class="advice">{{advice}}</view>

      <view class="latest-actions">
        <button class="btn-ghost" bindtap="goHistory">查看全部记录</button>
        <button class="btn-primary" bindtap="goAssessment">再测一次</button>
      </view>
    </view>

    <view class="card">
      <view class="section-title">风险趋势</view>
      <view wx:if="{{hasTrend}}">
        <view class="trend-row" wx:for="{{trend}}" wx:key="id">
          <text class="trend-date">{{item.date}}</text>
          <view class="trend-track">
            <view class="trend-fill {{item.widthClass}} {{item.colorClass}}"></view>
          </view>
          <text class="trend-score {{item.colorClass}}">{{item.prob}}%</text>
        </view>
      </view>
      <view wx:else class="muted">再做一次评估后，这里会显示风险变化趋势。</view>
    </view>
  </block>

  <view wx:else class="card empty-card">
    <view class="empty-title">还没有评估记录</view>
    <view class="empty-desc">完成一次评估后，这里会生成你的健康报告。</view>
    <button class="btn-primary" bindtap="goAssessment">开始评估</button>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="disclaimer">报告结果仅供参考，不能替代专业医生诊断。如有不适请及时就医。</view>
</view>
