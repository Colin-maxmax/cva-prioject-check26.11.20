page {
  background: #f5f7fa;
}

.report-page {
  padding: 32rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.page-head {
  padding: 24rpx 8rpx 32rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1f2937;
}

.page-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 30rpx rgba(15, 23, 42, 0.06);
}

.latest-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.latest-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.latest-date {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

.risk-badge {
  font-size: 30rpx;
  font-weight: 700;
}

.latest-metrics {
  display: flex;
  gap: 24rpx;
  margin: 30rpx 0;
}

.metric {
  flex: 1;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 20rpx;
  text-align: center;
}

.metric-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2937;
}

.metric-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.factors {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.factor {
  font-size: 24rpx;
  color: #2F80ED;
  background: #eff6ff;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.advice {
  font-size: 27rpx;
  color: #4b5563;
  line-height: 1.7;
  background: #f0fdf4;
  border-left: 6rpx solid #0E9F6E;
  padding: 18rpx 20rpx;
  border-radius: 10rpx;
}

.latest-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.latest-actions button {
  flex: 1;
  margin: 0;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.btn-primary {
  background: linear-gradient(135deg, #0E9F6E, #2F80ED);
  color: #fff;
  border: none;
}

.btn-ghost {
  background: #eff6ff;
  color: #2F80ED;
  border: 1rpx solid #bfdbfe;
}

.btn-primary::after,
.btn-ghost::after {
  border: none;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 24rpx;
}

.trend-row {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.trend-date {
  width: 110rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.trend-track {
  flex: 1;
  height: 18rpx;
  background: #f1f5f9;
  border-radius: 9rpx;
  overflow: hidden;
  margin: 0 16rpx;
}

.trend-fill {
  height: 100%;
  border-radius: 9rpx;
}

.trend-fill.w10 { width: 10%; }
.trend-fill.w20 { width: 20%; }
.trend-fill.w30 { width: 30%; }
.trend-fill.w40 { width: 40%; }
.trend-fill.w50 { width: 50%; }
.trend-fill.w60 { width: 60%; }
.trend-fill.w70 { width: 70%; }
.trend-fill.w80 { width: 80%; }
.trend-fill.w90 { width: 90%; }
.trend-fill.w100 { width: 100%; }

.trend-fill.high { background: #D32F2F; }
.trend-fill.medium { background: #ED6C02; }
.trend-fill.low { background: #2E7D32; }
.trend-fill.default { background: #2F80ED; }

.trend-score {
  width: 60rpx;
  text-align: right;
  font-size: 24rpx;
  font-weight: 600;
}

.trend-score.high { color: #D32F2F; }
.trend-score.medium { color: #ED6C02; }
.trend-score.low { color: #2E7D32; }
.trend-score.default { color: #2F80ED; }

.muted {
  font-size: 26rpx;
  color: #9ca3af;
  line-height: 1.6;
}

.empty-card {
  text-align: center;
  padding: 60rpx 32rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.empty-desc {
  margin: 16rpx 0 30rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.empty-card .btn-primary {
  width: 70%;
  margin: 0 auto;
  height: 84rpx;
  box-sizing: border-box;
  padding: 0;
  border-radius: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.state {
  text-align: center;
  padding: 120rpx 0;
  color: #6b7280;
  font-size: 28rpx;
}

.error {
  text-align: center;
  color: #ED6C02;
  font-size: 24rpx;
  margin-bottom: 20rpx;
}

.disclaimer {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #9ca3af;
  line-height: 1.6;
}
