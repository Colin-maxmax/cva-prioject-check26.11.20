page {
  background: #f5f7fa;
}

.profile-page {
  min-height: 100vh;
  padding: 28rpx 32rpx calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.group {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(15, 23, 42, 0.04);
}

.row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 0 28rpx;
  border-top: 1rpx solid #f8fafc;
  box-sizing: border-box;
}

.row:first-child {
  border-top: none;
}

.row-label {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 30rpx;
  color: #1f2937;
}

.row-value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #6b7280;
  word-break: break-all;
}

.row-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #1f2937;
}

.id-value {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.id-prefix {
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: #9ca3af;
  border: 1rpx solid #d1d5db;
  border-radius: 6rpx;
  padding: 0 8rpx;
  margin-right: 8rpx;
}

.id-num {
  font-size: 28rpx;
  font-weight: 600;
  color: #6b7280;
}

.row-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  margin-left: auto;
  background: #e5edf9;
  display: block;
  flex-shrink: 0;
}

.chevron {
  margin-left: 12rpx;
  color: #cbd5e1;
  font-size: 36rpx;
  line-height: 1;
}

.row-btn {
  width: 100% !important;
  display: flex !important;
  align-items: center;
  justify-content: flex-start !important;
  margin: 0 !important;
  padding: 0 28rpx !important;
  height: auto;
  min-height: 104rpx;
  background: #fff !important;
  border-radius: 0 !important;
  font-size: 30rpx;
  line-height: normal;
  text-align: left;
}

.row-btn::after {
  border: none;
}

.tip {
  margin: 20rpx 8rpx 28rpx;
  font-size: 22rpx;
  color: #9ca3af;
  line-height: 1.6;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  margin: 12rpx 0 0;
  padding: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  border-radius: 44rpx;
  background: #2F80ED;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.save-btn::after {
  border: none;
}

.save-btn[disabled] {
  opacity: 0.6;
  color: #fff;
  background: #2F80ED;
}
