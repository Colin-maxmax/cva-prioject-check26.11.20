@import "../agreement/agreement.wxss";

page {
  background: #f5f7fa;
}

.emergency-page {
  padding: 32rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.emergency-header {
  background: linear-gradient(135deg, #D32F2F, #EF5350);
  border-radius: 22rpx;
  padding: 32rpx 32rpx 36rpx;
  color: #fff;
  margin-bottom: 28rpx;
}

.emergency-badge {
  display: inline-block;
  font-size: 22rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  padding: 6rpx 16rpx;
  margin-bottom: 14rpx;
}

.emergency-title {
  font-size: 42rpx;
  font-weight: 700;
}

.emergency-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.86);
  line-height: 1.6;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(15, 23, 42, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0E9F6E;
  margin-bottom: 16rpx;
}

.card-title.red-title {
  color: #D32F2F;
}

.step-head {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.step-no {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #D32F2F;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
  line-height: 40rpx;
  margin-right: 14rpx;
}

.step-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  line-height: 1.4;
}

.step-text {
  font-size: 27rpx;
  color: #4b5563;
  line-height: 1.7;
  margin-bottom: 10rpx;
}

.sub-title {
  margin-top: 18rpx;
  margin-bottom: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.mnemonic-title {
  margin-top: 18rpx;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #D32F2F;
}

.mnemonic-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.mnemonic-num {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #fff2f0;
  color: #D32F2F;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  line-height: 48rpx;
  margin-right: 16rpx;
}

.mnemonic-body {
  flex: 1;
}

.mnemonic-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 4rpx;
}

.mnemonic-desc {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.6;
}

.warn-box {
  margin-top: 12rpx;
  background: #fff7f5;
  border-left: 6rpx solid #D32F2F;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.warn-line {
  font-size: 26rpx;
  color: #7f1d1d;
  line-height: 1.7;
  margin-bottom: 6rpx;
}

.warn-line:last-child {
  margin-bottom: 0;
}

.item {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.7;
}

.reference {
  text-align: center;
  font-size: 22rpx;
  color: #b0b7c3;
  line-height: 1.6;
  margin-top: 4rpx;
}

.disclaimer {
  text-align: center;
  font-size: 24rpx;
  color: #9ca3af;
  line-height: 1.6;
  margin-top: 20rpx;
}

.coming-card {
  margin-top: 40rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 6rpx 24rpx rgba(15, 23, 42, 0.04);
}

.coming-icon {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: #eff6ff;
  color: #2F80ED;
  font-size: 38rpx;
  font-weight: 600;
}

.coming-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.coming-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.7;
}

.coming-tip {
  margin-top: 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: #9ca3af;
}
